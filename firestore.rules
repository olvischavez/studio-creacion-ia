rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email.lower() == 'olvischavezmustafa@gmail.com');
    }

    // 1. USUARIOS Y TEMÁTICAS GUARDADAS
    // Las temáticas quedan guardadas permanentemente aunque la membresía expire
    match /users/{userId} {
      allow read, write: if isSignedIn();

      match /savedProjects/{projectId} {
        allow read, write: if isSignedIn();
      }
    }

    // 2. AVISOS DE PAGO QR Y BINANCE
    // Los usuarios envían: nombre, correo, comprobante, fecha y descripción
    match /paymentNotices/{noticeId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 3. AJUSTES DEL SISTEMA (Precios y datos de QR)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Denegar cualquier otra ruta no autorizada
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
